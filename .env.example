# Environment. Copy to `.env` and fill in the values marked REQUIRED:
#   cp .env.example .env
# `.env` is git-ignored. Never commit real secrets. Generate random values with: openssl rand -hex 32
# Keys marked "(Phase N)" are documented now but only read from that roadmap phase on.

# ── Docker Compose ───────────────────────────────────────────────────────────
# Lets you run plain `docker compose up` from the repo root.
# The compose project name is set in deploy/docker-compose.yml, so it isn't needed here.
COMPOSE_FILE=deploy/docker-compose.yml:deploy/docker-compose.langfuse.yml
# Optional profiles to start with plain `docker compose up`, comma separated: host-llm-bridge, llamacpp-cpu, ollama-cpu, langfuse
COMPOSE_PROFILES=

# ── PostgreSQL (projects, runs, checkpoints, graph, pgvector) ────────────────
# REQUIRED. Password for the bundled Postgres. User and database default to the names in deploy/docker-compose.yml;
# set POSTGRES_USER / POSTGRES_DB only to override them.
POSTGRES_PASSWORD=

# ── Host ports (all bound to 127.0.0.1 only) ─────────────────────────────────
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5442
# Bundled llama.cpp (profile `llamacpp-cpu`); 8090 so it doesn't clash with a llama-server already on 8080.
LLAMACPP_PORT=8090
# Bundled Ollama (profile `ollama-cpu`); 11435 so it doesn't clash with an Ollama already on the host.
OLLAMA_PORT=11435

# ── API ──────────────────────────────────────────────────────────────────────
# Only for running the API outside Docker (`uv run uvicorn ...`). Compose builds its own from POSTGRES_*.
# DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5442/<db>
# debug | info | warning | error
LOG_LEVEL=info
# Path to the LLM profiles file (default: config/models.yaml in the repo).
# MODELS_CONFIG=config/models.yaml
# Where project workspaces live (default: ./workspaces; in Docker a named volume).
# WORKSPACES_DIR=workspaces

# ── LLM (README Section 10) ───────────────────────────────────────────────────
# Both profiles are llama.cpp servers used through their OpenAI-compatible API, so switching is a URL change.
# Leave empty to use config/models.yaml; the Settings page can override these at runtime.
# Remote RTX 3080 box, e.g. https://<tunnel>.ngrok-free.app/v1, http://100.64.0.5:8080/v1 (Tailscale) or http://127.0.0.1:18080/v1 (SSH -L)
LLM_REMOTE_GPU_URL=
# Local CPU llama-server. From inside Docker the host is host.docker.internal.
LLM_LOCAL_CPU_URL=
# A llama-server on this machine that listens on 127.0.0.1 only can't be reached from containers. Enable the
# `host-llm-bridge` profile (COMPOSE_PROFILES below) to forward the Docker bridge address to it.
HOST_LLM_PORT=8080
HOST_EMBED_PORT=8081
DOCKER_BRIDGE_IP=172.17.0.1
# Optional API keys in front of the model servers (llama.cpp --api-key / a proxy in front of Ollama).
# config/models.yaml refers to these by name; leave empty if the server has no key.
REMOTE_GPU_API_KEY=
LOCAL_CPU_API_KEY=
# Folder with GGUF model files, mounted read-only into the `llamacpp-cpu` profile.
# Leave empty to use the repo's git-ignored models/ folder, or give an ABSOLUTE path to an existing folder
# instead of copying multi-GB files, e.g. MODELS_DIR=/home/you/models
MODELS_DIR=
GGUF_FILE=Qwen3.5-9B-Q4_K_M.gguf
# External (non self-hosted) LLM providers. Keep false: when true, code may leave this machine.
EXTERNAL_LLM_ENABLED=false

# ── Tests ────────────────────────────────────────────────────────────────────
# `make check` runs every check inside Docker against a throwaway test database, so nothing is needed here.
# Only for running the tests on the host: a THROWAWAY database (migrated down/up and wiped on every run).
# TEST_DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5442/<db>_test

# ── Connectors (Phase 3) ─────────────────────────────────────────────────────
# (Phase 3) Key used to encrypt tokens stored locally (GitHub PAT, Google refresh token).
SECRET_KEY=
# (Phase 3) Host folder mounted read-only as the "Local folder" input source.
LOCAL_SOURCE_DIR=
# (Phase 3) Host folder(s), comma separated, that delivery may write into.
ALLOWED_OUTPUT_DIRS=
# (Phase 3) GitHub personal access token for private repos and PRs (can also be set in Settings).
GITHUB_TOKEN=
# (Phase 3) Path to the Google OAuth "Desktop app" client JSON (ADR 0005).
GOOGLE_OAUTH_CLIENT_FILE=

# ── Langfuse (optional profile `langfuse`) ───────────────────────────────────
# Only needed for `docker compose --profile langfuse up`. All REQUIRED when the profile is used.
# API keys for this app's project in Langfuse (created on first start). Any values in this format:
#   LANGFUSE_PUBLIC_KEY=pk-lf-<random>   LANGFUSE_SECRET_KEY=sk-lf-<random>
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Where the API sends traces. Inside compose: http://langfuse-web:3000. Leave empty to disable.
LANGFUSE_BASE_URL=
# Your Langfuse login (created on first start), at http://localhost:${LANGFUSE_PORT}
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_PORT=3001
LANGFUSE_MINIO_PORT=9090
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# 64 hex characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
