# MonoShift environment. Copy to `.env` and fill in the values marked REQUIRED:
#   cp .env.example .env
# `.env` is git-ignored. Never commit real secrets. Generate random values with: openssl rand -hex 32
# Keys marked "(Phase N)" are documented now but only read from that roadmap phase on.

# ── Docker Compose ───────────────────────────────────────────────────────────
# Lets you run plain `docker compose up` from the repo root.
COMPOSE_FILE=deploy/docker-compose.yml:deploy/docker-compose.langfuse.yml
COMPOSE_PROJECT_NAME=monoshift

# ── PostgreSQL (projects, runs, checkpoints, graph, pgvector) ────────────────
POSTGRES_USER=monoshift
# REQUIRED. Password for the bundled Postgres.
POSTGRES_PASSWORD=
POSTGRES_DB=monoshift

# ── Host ports (all bound to 127.0.0.1 only) ─────────────────────────────────
MONOSHIFT_WEB_PORT=3000
MONOSHIFT_API_PORT=8000
MONOSHIFT_POSTGRES_PORT=5442
# Bundled llama.cpp (profile `llamacpp-cpu`); 8090 so it doesn't clash with a llama-server already on 8080.
MONOSHIFT_LLAMACPP_PORT=8090
# Bundled Ollama (profile `ollama-cpu`); 11435 so it doesn't clash with an Ollama already on the host.
MONOSHIFT_OLLAMA_PORT=11435

# ── API ──────────────────────────────────────────────────────────────────────
# Database URL for running the API outside Docker (`uv run uvicorn ...`). Compose builds its own from POSTGRES_*.
MONOSHIFT_DATABASE_URL=postgresql://monoshift:CHANGE_ME@127.0.0.1:5442/monoshift
# debug | info | warning | error
MONOSHIFT_LOG_LEVEL=info
# Path to the LLM profiles file (default: config/models.yaml in the repo).
# MONOSHIFT_MODELS_CONFIG=config/models.yaml
# Where project workspaces live (default: ./workspaces; in Docker a named volume).
# MONOSHIFT_WORKSPACES_DIR=workspaces

# ── LLM (README Section 8) ───────────────────────────────────────────────────
# Optional API keys in front of the model servers (llama.cpp --api-key / a proxy in front of Ollama).
# config/models.yaml refers to these by name; leave empty if the server has no key.
MONOSHIFT_REMOTE_GPU_API_KEY=
MONOSHIFT_LOCAL_CPU_API_KEY=
# Folder with GGUF model files, mounted read-only into the `llamacpp-cpu` profile.
# Leave empty to use the repo's git-ignored models/ folder, or give an ABSOLUTE path to an existing folder
# instead of copying multi-GB files, e.g. MONOSHIFT_MODELS_DIR=/home/you/models
MONOSHIFT_MODELS_DIR=
MONOSHIFT_GGUF_FILE=Qwen3.5-9B-Q4_K_M.gguf
# External (non self-hosted) LLM providers. Keep false: when true, code may leave this machine.
MONOSHIFT_EXTERNAL_LLM_ENABLED=false

# ── Tests ────────────────────────────────────────────────────────────────────
# A THROWAWAY database for the API's DB tests: it is migrated down/up and wiped on every run.
# Example with the compose Postgres: create it once with
#   docker compose exec postgres createdb -U monoshift monoshift_test
MONOSHIFT_TEST_DATABASE_URL=postgresql://monoshift:CHANGE_ME@127.0.0.1:5442/monoshift_test

# ── Connectors (Phase 2) ─────────────────────────────────────────────────────
# (Phase 2) Key used to encrypt tokens stored locally (GitHub PAT, Google refresh token).
MONOSHIFT_SECRET_KEY=
# (Phase 2) Host folder mounted read-only as the "Local folder" input source.
MONOSHIFT_LOCAL_SOURCE_DIR=
# (Phase 2) Host folder(s), comma separated, that Gate 8 may deliver into.
MONOSHIFT_ALLOWED_OUTPUT_DIRS=
# (Phase 2) GitHub personal access token for private repos and PRs (can also be set in Settings).
MONOSHIFT_GITHUB_TOKEN=
# (Phase 2) Path to the Google OAuth "Desktop app" client JSON (ADR 0005).
MONOSHIFT_GOOGLE_OAUTH_CLIENT_FILE=

# ── Langfuse (optional profile `langfuse`) ───────────────────────────────────
# Only needed for `docker compose --profile langfuse up`. All REQUIRED when the profile is used.
LANGFUSE_PORT=3001
LANGFUSE_MINIO_PORT=9090
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# 64 hex characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
